Write function that calculated the area of a rectanngle
area = LW
double area of Rect( double L, double W){
    double result = L * W;
    return result;
}

Problem 1:
def madlib(noun: str, adjective: str, verb: str) -> str:
    # Combines the inputs into a full sentence
    return f"The {adjective} {noun} {verb}"

Problem 2:
def calculate_square_area(side_length: float) -> float:
    # Area of a square = side * side
    return side_length ** 2

Problem 3:
def calculate_circle_area(radius: float) -> float:
    # Area of a circle = π * r²
    return math.pi * (radius ** 2)
