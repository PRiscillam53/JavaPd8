Problem:1
string weather(double temp){
    if(temp >= 70)
        return "Warm to Hot";
    else
        return "Cool to Cold";
}
Problem2:
string batteryStatus(double battery){
    if (battery < 0.1) 
        return "Need to recharge";
    else 
        return "Normal";
}    

Classwork:
1. double discount(double amountSpent){ 
    if (amountSpent > 100)
        return 0.10;
    else 
        return 0.0; 
}
2. string honors(double gpa){ 
    if (gpa >= 90) 
        return "Honor Student"; 
    else return "Work harder"; 
}
3. string shortSize(double wasteMeasurement){ 
    if (wasteMeasurement < 36) 
        return "Medium"; 
    else return "Large"; 
}
